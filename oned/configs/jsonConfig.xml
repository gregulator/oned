<Protocol Name="JSON">
    <Field Name="name" Type="string"/>
    <Field Name="age" Type="integer"/>
    <Field Name="address" Type="object">
        <SubField Name="street" Type="string"/>
        <SubField Name="city" Type="string"/>
        <SubField Name="zipcode" Type="integer"/>
    </Field>
    <Field Name="emails" Type="array">
        <ArrayField Name="email" Type="string"/>
    </Field>
</Protocol>
